# Contoh env untuk keeper/rfq-server.ts (RFQ lokal). Salin ke rfq.env (diabaikan git) dan isi sendiri.
# JANGAN menaruh kunci atau token asli di file .example ini: file ini ikut ter-commit.
RFQ_PICKER_PRIVATE_KEY=0x<64 karakter heksa dari: cast wallet decrypt-keystore espalier-picker>
RFQ_TOKEN=<hasil: openssl rand -hex 32>
RFQ_PREMIUM_RAW=5000000
