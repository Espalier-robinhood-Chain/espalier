KEEPER_RPC_URL=
KEEPER_CHAIN_ID=46630
CORDON_VAULT_ADDRESS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KEEPER_MODE=dry-run          # live = kirim prune() sungguhan; butuh KEEPER_PRIVATE_KEY (KEEPER_ROLE di CordonVault)
# Opsional (default): POLL_MS=60000 DRIFT_THRESHOLD_BPS=100 MIN_INTERVAL_DAYS=30 SLIPPAGE_BPS=50 MIN_TRADE_USD=50 MAX_TRADES=16

# Keeper Spur (opsional; kosongkan SPUR_VAULT_ADDRESS bila belum ada). SPUR_MODE=dry-run (default): hanya simulasi, tidak mengirim apa pun.
# SPUR_VAULT_ADDRESS=
# SPUR_MODE=dry-run
# KEEPER_ADDRESS=            # akun KEEPER untuk simulasi (dry-run); di mode live diturunkan dari kunci
# KEEPER_PRIVATE_KEY=        # hanya untuk SPUR_MODE=live; kunci panas dengan wewenang sempit (KEEPER_ROLE), jangan dipakai untuk hal lain
# RFQ_URL=                   # layanan RFQ Picker (protokol v0, lihat README); kosong = fill tidak dijalankan
# RFQ_TOKEN=
# RFQ_TIMEOUT_MS=5000

# Keeper Graft (opsional; kosongkan GRAFT_VAULT_ADDRESS bila belum ada). Memakai KEEPER_ADDRESS/KEEPER_PRIVATE_KEY dan RFQ_* di atas.
# Akun keeper harus punya KEEPER_ROLE di GraftVault (dan di HarvestAuction, sama seperti Spur).
# GRAFT_VAULT_ADDRESS=
# GRAFT_MODE=dry-run
