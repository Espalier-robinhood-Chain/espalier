# Supabase (Project Settings → API). Boleh pakai publishable key baru atau anon key lama.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key TIDAK dipakai di web. Hanya untuk indexer/keeper (server terpisah).

# Mode jaringan situs: mainnet atau testnet. KOSONG = mode simulasi (situs tetap jalan, tanpa connect wallet dan tanpa transaksi).
# Nilai ini di-inline saat build/dev start: setelah mengubahnya, restart `npm run dev` atau build ulang.
# testnet butuh NEXT_PUBLIC_RH_RPC_TESTNET; mainnet/testnet butuh NEXT_PUBLIC_REOWN_PROJECT_ID. Kalau kurang, tombol wallet mati.
# Chain vault (NEXT_PUBLIC_CORDON_VAULT_CHAIN_ID) harus sama dengan mode (mainnet 4663, testnet 46630), kalau tidak panel tetap simulasi.
NEXT_MODE=

# Wallet connect (Reown AppKit). Project ID dari dashboard.reown.com. Kosong = tombol wallet dinonaktifkan, situs tetap jalan.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Harus sama dengan domain situs (Reown mencocokkan domain). Lokal: http://localhost:3000
# Juga dipakai sebagai dasar URL gambar OG (metadataBase). Isi SAAT BUILD: halaman statis (mis. /) menulis URL ini ke HTML saat build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# RPC Robinhood Chain. NEXT_PUBLIC_* terlihat di browser: pakai kunci yang dibatasi domain, bukan kunci server.
# Mainnet kosong = RPC publik (rate-limited, hanya untuk dev). Testnet kosong = testnet 46630 tidak ditawarkan di wallet.
NEXT_PUBLIC_RH_RPC_MAINNET=
NEXT_PUBLIC_RH_RPC_TESTNET=

# Panel mint/redeem sungguhan (tahap 2). Isi setelah CordonVault ter-deploy (alamat ada di contracts/deployments/<nama>.json, field cordonVault).
# Kosong = panel tetap simulasi. Chain default 46630 (testnet); chain itu harus ada di wallet/AppKit (testnet butuh NEXT_PUBLIC_RH_RPC_TESTNET).
# SYMBOL harus sama dengan simbol cordon di URL (/cordons/cMAG7). Hanya satu vault per deployment.
NEXT_PUBLIC_CORDON_VAULT_ADDRESS=
NEXT_PUBLIC_CORDON_VAULT_CHAIN_ID=46630
NEXT_PUBLIC_CORDON_VAULT_SYMBOL=cMAG7

# Panel deposit/withdraw Spur sungguhan. Isi setelah SpurVault ter-deploy (alamat ada di contracts/deployments/<nama>.json, field spurVault).
# Kosong = panel tetap simulasi. Chain harus sama dengan NEXT_MODE (testnet 46630, mainnet 4663), kalau tidak panel tetap simulasi.
# SYMBOL harus sama dengan vaults.symbol di Supabase (default indexer: "s" + ticker aset, mis. sNVDA), karena itu yang ada di URL /vaults/sNVDA.
# Hanya satu SpurVault per deployment. Graft punya env sendiri di bawah.
NEXT_PUBLIC_SPUR_VAULT_ADDRESS=
NEXT_PUBLIC_SPUR_VAULT_CHAIN_ID=46630
NEXT_PUBLIC_SPUR_VAULT_SYMBOL=sNVDA

# Panel deposit/withdraw Graft sungguhan (cash-secured put, collateral USDG). Isi setelah GraftVault ter-deploy (field graftVault di contracts/deployments/<nama>.json).
# Aturannya sama dengan Spur: kosong = panel Graft tetap simulasi; chain harus sama dengan NEXT_MODE (testnet 46630, mainnet 4663).
# SYMBOL harus sama dengan vaults.symbol di Supabase (default indexer: "g" + ticker acuan, mis. gNVDA), karena itu yang ada di URL /vaults/gNVDA.
# Hanya satu GraftVault per deployment.
NEXT_PUBLIC_GRAFT_VAULT_ADDRESS=
NEXT_PUBLIC_GRAFT_VAULT_CHAIN_ID=46630
NEXT_PUBLIC_GRAFT_VAULT_SYMBOL=gNVDA

# Opsional (server saja, tanpa NEXT_PUBLIC_): RPC untuk membaca round berjalan langsung dari kontrak di /vaults dan /api/vaults.
# Kosong = memakai NEXT_PUBLIC_RH_RPC_TESTNET / NEXT_PUBLIC_RH_RPC_MAINNET sesuai chain vault. Round berjalan tidak lagi menunggu indexer.
# LIVE_RPC_URL=
