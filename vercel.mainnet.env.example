# =====================================================================================================
# Espalier: environment Vercel MAINNET (Robinhood Chain 4663). TEMPLATE: tidak berisi rahasia.
# Isi di Vercel > Settings > Environment Variables (tandai yang rahasia "Sensitive"), lalu REDEPLOY
# (NEXT_PUBLIC_* dan NEXT_MODE ditanam saat build). JANGAN menyalin kunci dari file testnet.
# =====================================================================================================

# ---------- WEB (publik) ----------
NEXT_PUBLIC_SUPABASE_URL=            # disarankan project Supabase BARU khusus mainnet
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_MODE=mainnet
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Domain produksi, tanpa garis miring di akhir; sama dengan domain yang didaftarkan di Reown.
NEXT_PUBLIC_SITE_URL=https://domain-anda.com
NEXT_PUBLIC_X_URL=
# RPC berbayar (Alchemy/penyedia lain) yang DIBATASI ke domain Anda. RPC publik rate-limited, bukan untuk produksi.
NEXT_PUBLIC_RH_RPC_MAINNET=

# Alamat dari contracts/deployments/robinhood-mainnet.json. Chain id WAJIB 4663, kalau tidak panel tetap simulasi.
NEXT_PUBLIC_CORDON_VAULT_ADDRESS=
NEXT_PUBLIC_CORDON_VAULT_CHAIN_ID=4663
NEXT_PUBLIC_CORDON_VAULT_SYMBOL=cMAG7
# Spur/Graft/cCHIP/cVOLT: isi hanya yang benar-benar di-deploy di mainnet; kosongkan sisanya (panel tetap simulasi).
NEXT_PUBLIC_SPUR_VAULT_ADDRESS=
NEXT_PUBLIC_SPUR_VAULT_CHAIN_ID=4663
NEXT_PUBLIC_SPUR_VAULT_SYMBOL=sNVDA
NEXT_PUBLIC_GRAFT_VAULT_ADDRESS=
NEXT_PUBLIC_GRAFT_VAULT_CHAIN_ID=4663
NEXT_PUBLIC_GRAFT_VAULT_SYMBOL=gNVDA
NEXT_PUBLIC_CCHIP_VAULT_ADDRESS=
NEXT_PUBLIC_CCHIP_VAULT_CHAIN_ID=4663
NEXT_PUBLIC_CCHIP_VAULT_SYMBOL=cCHIP
NEXT_PUBLIC_CVOLT_VAULT_ADDRESS=
NEXT_PUBLIC_CVOLT_VAULT_CHAIN_ID=4663
NEXT_PUBLIC_CVOLT_VAULT_SYMBOL=cVOLT

# ---------- SERVER: rahasia dasar ----------
CRON_SECRET=                         # openssl rand -hex 32 (BARU); nilai sama di Vault Supabase (espalier_cron_secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- SERVER: indexer ----------
INDEXER_RPC_URL=
INDEXER_CHAIN_ID=4663
CORDON_VAULT_ADDRESS=
START_BLOCK=                         # nomor block saat vault di-deploy (bukan 0)
# Urutan WAJIB: cCHIP dulu, lalu cVOLT (cordon1 = cCHIP, cordon2 = cVOLT di indexer dan keeper):
# EXTRA_CORDONS=0x<cCHIP>@<blok_cCHIP>,0x<cVOLT>@<blok_cVOLT>
EXTRA_CORDONS=
SPUR_VAULT_ADDRESS=
SPUR_START_BLOCK=
SPUR_VAULT_SYMBOL=sNVDA
GRAFT_VAULT_ADDRESS=
GRAFT_START_BLOCK=
GRAFT_VAULT_SYMBOL=gNVDA
LOG_CHUNK=10                         # aman untuk Alchemy gratis; naikkan bila penyedia RPC mengizinkan
MAX_CHUNKS_PER_RUN=100               # potongan getLogs maks per putaran cron (bawaan 100; 0 = tanpa batas). Supaya kursor tetap maju saat mengejar
                                     # (100 x LOG_CHUNK 10 = 1000 blok per menit). Mengejar Spur/Graft membaca state lama: pakai RPC ARSIP (Alchemy: ya).
POLL_MS=15000
NAV_EVERY_MS=60000

# ---------- SERVER: keeper (LIVE lewat cron Vercel) ----------
# Dompet khusus: hanya KEEPER_ROLE (SpurVault, GraftVault, HarvestAuction, tiap CordonVault), saldo ETH secukupnya. BUKAN owner/deployer.
# Urutan aman: mulai dengan *_MODE=dry-run (tanpa KEEPER_PRIVATE_KEY, cukup KEEPER_ADDRESS), cek hasilnya, baru live.
KEEPER_RPC_URL=
KEEPER_CHAIN_ID=4663
KEEPER_MODE=dry-run                  # live = pruning Cordon sungguhan
SPUR_MODE=dry-run                    # live = rollRound/fill/settle sungguhan
GRAFT_MODE=dry-run
KEEPER_ADDRESS=
# Untuk LIVE di mainnet isi KEDUANYA (tandai Sensitive di Vercel):
# KEEPER_PRIVATE_KEY=
# ALLOW_MAINNET_CRON_KEEPER=true

# ---------- SERVER: Picker (dompet milik sendiri, USDG sungguhan) ----------
# Dompet Picker: terdaftar di pickers[] config deploy, punya USDG dan ETH (gas klaim), dan approve USDG ke HarvestAuction.
# Dompet BERBEDA dari keeper dan owner. Tanpa RFQ_URL keeper melewati fill (round tidak terjual).
RFQ_ALLOW_MAINNET=true
RFQ_PICKER_PRIVATE_KEY=              # Sensitive
RFQ_TOKEN=                           # openssl rand -hex 32
RFQ_URL=https://domain-anda.com/api/rfq
RFQ_AUCTION_ADDRESS=                 # HarvestAuction mainnet
# WAJIB eksplisit di mainnet (satuan mentah; USDG 6 desimal, notional 18 desimal). Contoh kecil, putuskan sendiri:
RFQ_PREMIUM_RAW=                     # premi tetap per round, mis. 5000000 = 5 USDG
RFQ_MAX_PREMIUM_RAW=                 # batas atas premi; minPremium round di atas ini dijawab quote kosong
RFQ_MAX_NOTIONAL_RAW=                # batas notional round yang mau Anda layani, mis. 2000000000000000000 = 2 token

# ---------- SERVER: pemantau (opsional, ada nilai bawaan) ----------
# HEALTH_MAX_STALE_SEC=600
# HEALTH_MIN_ETH_WEI=3000000000000000
# HEALTH_MIN_PICKER_USDG_RAW=

# JANGAN isi di mainnet: FEED_BOT_PRIVATE_KEY, FEED_ADDRESSES (route /api/cron/feeds menolak 4663).
